      "SKUPerformanceResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SKUPerformanceItem"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "total": {
            "type": "integer",
            "title": "Total"
