            "title": "Id"
          },
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "sku_actions": {
            "$ref": "#/components/schemas/SKUActionsSchema"
