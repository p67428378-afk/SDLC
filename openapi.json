          "guardrail_status": {
            "$ref": "#/components/schemas/GuardrailsSchema"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "scenario_name",
          "user_id",
          "sku_actions",
          "guardrail_status",
          "created_at"
        ],
        "title": "AssortmentSubmitResponse"
