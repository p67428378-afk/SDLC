{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor API",
    "description": "Decision-support tool for Dollar General category managers",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/assortment/kpis": {
      "get": {
        "summary": "Get Kpis",
        "operationId": "get_kpis_api_v1_assortment_kpis_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KpiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/skus": {
      "get": {
        "summary": "Get Skus",
        "operationId": "get_skus_api_v1_assortment_skus_get",
        "parameters": [
          {
            "name": "cluster",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "small-town-value",
              "title": "Cluster"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SkuResponse"
                  },
                  "title": "Response Get Skus Api V1 Assortment Skus Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/scenarios/{scenario_name}": {
      "get": {
        "summary": "Get Scenario",
        "operationId": "get_scenario_api_v1_assortment_scenarios__scenario_name__get",
        "parameters": [
          {
            "name": "scenario_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/submit": {
      "post": {
        "summary": "Submit Assortment",
        "operationId": "submit_assortment_api_v1_assortment_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Guardrails": {
        "properties": {
          "private_brand_ok": {
            "type": "boolean",
            "title": "Private Brand Ok"
          },
          "shelf_capacity_ok": {
            "type": "boolean",
            "title": "Shelf Capacity Ok"
          }
        },
        "type": "object",
        "required": [
          "private_brand_ok",
          "shelf_capacity_ok"
        ],
        "title": "Guardrails"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KpiResponse": {
        "properties": {
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "private_brand_pct": {
            "type": "number",
            "title": "Private Brand Pct"
          },
          "sales_lift_pct": {
            "type": "number",
            "title": "Sales Lift Pct"
          },
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "shelf_capacity_utilization": {
            "type": "number",
            "title": "Shelf Capacity Utilization"
          }
        },
        "type": "object",
        "required": [
          "in_stock_rate",
          "private_brand_pct",
          "sales_lift_pct",
          "sales_per_linear_ft",
          "shelf_capacity_utilization"
        ],
        "title": "KpiResponse"
      },
      "ScenarioResponse": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "projected_sales_lift": {
            "type": "number",
            "title": "Projected Sales Lift"
          },
          "shelf_capacity": {
            "type": "number",
            "title": "Shelf Capacity"
          },
          "private_brand_mix": {
            "type": "number",
            "title": "Private Brand Mix"
          },
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "guardrails": {
            "$ref": "#/components/schemas/Guardrails"
          },
          "sku_actions": {
            "items": {
              "$ref": "#/components/schemas/SkuAction"
            },
            "type": "array",
            "title": "Sku Actions"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "projected_sales_lift",
          "shelf_capacity",
          "private_brand_mix",
          "in_stock_rate",
          "guardrails",
          "sku_actions"
        ],
        "title": "ScenarioResponse"
      },
      "SkuAction": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "action"
        ],
        "title": "SkuAction"
      },
      "SkuResponse": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "sales": {
            "type": "number",
            "title": "Sales"
          },
          "units_sold": {
            "type": "integer",
            "title": "Units Sold"
          },
          "profit_margin": {
            "type": "number",
            "title": "Profit Margin"
          },
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "name",
          "brand",
          "sales",
          "units_sold",
          "profit_margin",
          "in_stock_rate",
          "status"
        ],
        "title": "SkuResponse"
      },
      "SubmitRequest": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "sku_actions": {
            "items": {
              "$ref": "#/components/schemas/SkuAction"
            },
            "type": "array",
            "title": "Sku Actions"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "sku_actions"
        ],
        "title": "SubmitRequest"
      },
      "SubmitResponse": {
        "properties": {
          "audit_id": {
            "type": "string",
            "title": "Audit Id"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "submitted_by": {
            "type": "string",
            "title": "Submitted By"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          }
        },
        "type": "object",
        "required": [
          "audit_id",
          "submitted_at",
          "submitted_by",
          "success"
        ],
        "title": "SubmitResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}