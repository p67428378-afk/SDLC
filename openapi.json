        "properties": {
          "private_brand_goal": {
            "type": "string",
            "title": "Private Brand Goal"
          },
          "shelf_capacity": {
            "type": "string",
            "title": "Shelf Capacity"
          }
        },
        "type": "object",
        "required": [
          "private_brand_goal",
          "shelf_capacity"
