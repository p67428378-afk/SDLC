          },
          "private_brand_pct": {
            "type": "number",
            "title": "Private Brand Pct"
          },
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "shelf_capacity_pct": {
            "type": "number",
            "title": "Shelf Capacity Pct"
