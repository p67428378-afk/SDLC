          },
          "sales_growth_pct": {
            "type": "number",
            "title": "Sales Growth Pct"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "private_brand",
          "sales",
          "sales_growth_pct",
          "status"
